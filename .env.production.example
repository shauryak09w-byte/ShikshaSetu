# Copy to project-root .env for Docker Compose. Use unique generated passwords.
POSTGRES_DB=shikshasetu
POSTGRES_USER=shikshasetu
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Public API hostname and the exact browser origins that host the frontend.
ALLOWED_HOSTS=api.example.edu
CORS_ORIGINS=https://portal.example.edu
