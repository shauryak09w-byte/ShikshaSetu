# Local development settings. Copy to backend-fastapi/.env.
SHIKSHASETU_ENV=development
DATABASE_URL=sqlite:///./data/shikshasetu-fastapi.db
BOOTSTRAP_SUPER_ADMIN_EMAIL=
SESSION_HOURS=8
AI_CHAT_RETENTION_DAYS=90
MAX_CSV_UPLOAD_MB=10
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=900
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501

# Firebase Web App configuration (public client settings; obtain from Firebase Console).
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=1:123456789:web:replace-with-your-app-id

# Firebase Admin SDK service-account JSON path (private; never commit this file).
# Place the JSON file inside backend-fastapi/ or use an absolute Windows path.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Production-only settings (move to the deployment secret manager / runtime config).
# SHIKSHASETU_ENV=production
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/shikshasetu
# ALLOWED_HOSTS=api.example.edu,localhost,127.0.0.1
# CORS_ORIGINS=https://portal.example.edu
# ALEMBIC_EXPECTED_REVISION=0001_baseline
